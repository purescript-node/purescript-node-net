{
  "private": true,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('output', { recursive: true, force: true })\"",
    "build": "npm run lint && spago build --pedantic-packages --strict",
    "test": "spago test --pedantic-packages",
    "lint": "oxlint --deny-warnings src test",
    "format": "purs-tidy format-in-place src test && oxfmt --write 'src/**/*.js' 'test/**/*.js'",
    "format:check": "purs-tidy check src test && oxfmt --check 'src/**/*.js' 'test/**/*.js'"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purs-tidy": "0.11.1",
    "purescript": "0.15.16",
    "spago": "1.0.4"
  }
}
